RDS_PUBLIC_HOST=rustdesk.example.net
# Stable identity and metadata for the built-in relay telemetry.
RDS_HBBR_ID=builtin-hbbr
RDS_HBBR_NAME=Built-in HBBR
RDS_HBBR_REGION=default
# Telemetry interval in seconds (2-300).
RDS_HBBR_TELEMETRY_INTERVAL=5
RDS_HBBS_ID=builtin-hbbs
RDS_SERVICE_HEARTBEAT_INTERVAL=5
# Must stay above the RustDesk rendezvous keep-alive interval (120 seconds).
RDS_DEVICE_ONLINE_TTL=180s
# When enabled, HBBS accepts RegisterPk only for devices enrolled with /api/devices/deploy.
RDS_REQUIRE_DEVICE_DEPLOYMENT=false
# Enroll users while optional, then choose required_for_admins or required_for_all_users.
RDS_MFA_MODE=optional
RDS_REGISTRATION_ENABLED=false
RDS_LDAP_URL=
RDS_LDAP_BIND_DN=
RDS_LDAP_BIND_PASSWORD=
RDS_LDAP_BASE_DN=
RDS_LDAP_USER_FILTER=(&(objectClass=person)(|(uid={username})(sAMAccountName={username})(userPrincipalName={username})))
RDS_LDAP_USERNAME_ATTRIBUTE=uid
RDS_LDAP_EMAIL_ATTRIBUTE=mail
RDS_LDAP_DISPLAY_NAME_ATTRIBUTE=displayName
RDS_LDAP_GROUP_ATTRIBUTE=memberOf
# Explicit directory group DN/name -> existing RustDesk user group ID mapping.
# RDS_LDAP_GROUP_MAPPING={"CN=Support,OU=Groups,DC=example,DC=com":"support-group-id"}

# Webhook SSRF protection. Keep false unless receivers are inside a trusted private network.
RDS_WEBHOOK_ALLOW_PRIVATE=false
RDS_LDAP_STARTTLS=true
RDS_LDAP_INSECURE_SKIP_VERIFY=false
RDS_LDAP_AUTO_PROVISION=false
# RDS_MFA_SECRET_FILE=/data/secrets/mfa.secret
# Generic OpenID Connect (disabled while RDS_OIDC_ISSUER is empty).
# RDS_OIDC_ISSUER=https://identity.example.com/realms/company
# RDS_OIDC_CLIENT_ID=rustdesk
# RDS_OIDC_CLIENT_SECRET=replace-with-provider-secret
# RDS_OIDC_REDIRECT_URL=https://rustdesk.example.com/api/oidc/callback
# RDS_OIDC_PROVIDER_NAME=company
# RDS_OIDC_SCOPES=openid profile email
# RDS_OIDC_AUTO_REGISTER=false
# Optional only on first start; otherwise a random password is written under /data/secrets.
# RDS_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password
# Dedicated token used only by isolated Client Builder workers.
# RDS_BUILDER_TOKEN_FILE=/data/secrets/builder.token
